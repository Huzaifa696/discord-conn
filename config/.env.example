# Discord User Authentication
# WARNING: Keep this private. Never commit your token to public repositories.
# Obtain via browser DevTools (Network tab -> Authorization header): https://discord.com/app
DISCORD_USER_TOKEN=your_discord_user_token_here

# Google Gemini API Key
# Obtain for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database Location (defaults to data/discord_conn.db)
DATABASE_PATH=data/discord_conn.db
